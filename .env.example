# Application Settings
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_BASE_PATH=/society_app
APP_URL=http://localhost
APP_KEY=REPLACE_WITH_64_HEX_RANDOM_KEY

# MySQL Database Configuration
DB_HOST=localhost
DB_NAME=society_app
DB_USER=root
DB_PASS=

# Web Push VAPID Keys (Generate via `web-push` or OpenSSL; keep private key secret!)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
