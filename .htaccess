# Disable directory browsing
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Direct high-speed download for Android APK (Case-insensitive, bypasses all directory checks)
    RewriteRule ^(apk(/.*)?|download/apk)$ https://github.com/shopquare/society_app/releases/download/v1.0.4/SocietyHub.apk [R=302,L,NC]

    # Block direct HTTP access to internal directories and sensitive files
    RewriteRule ^(config|includes|modules|docs|vendor|tests|uploads|\.github)/ - [F,L]
    RewriteRule ^(\.env.*|\.ftp-deploy-sync-state\.json|composer\.(json|lock)|\.git.*)$ - [F,L]

    # Allow direct access to physical files (assets, api/*.php, sw.js, manifest.json)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route all other requests (relative to directory) to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
